#!/usr/bin/env bash
set -euo pipefail
root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
libdir="${QTSPICE_PRIVATE_LIBSOUP_PREFIX:-$root/build/libsoup-private}/lib"
if [[ ! -f "$libdir/libsoup-3.0.so.0" ]]; then
    echo 'Build the patched library first: python3 scripts/build-private-libsoup.py' >&2
    exit 1
fi
if [[ $# == 0 ]]; then
    echo 'Usage: scripts/with-private-libsoup COMMAND [ARGUMENTS...]' >&2
    exit 1
fi
export LD_LIBRARY_PATH="$libdir${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
exec "$@"
