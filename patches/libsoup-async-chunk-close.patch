+static void
+async_chunk_close (gconstpointer data)
+{
+        int mode = GPOINTER_TO_INT (data);
+        GOutputStream *memory = g_memory_output_stream_new_resizable ();
+        SlowOutputStream *slow = g_object_new (slow_output_stream_get_type (), "base-stream", memory, NULL);
+        GOutputStream *body = soup_body_output_stream_new (G_OUTPUT_STREAM (slow), SOUP_ENCODING_CHUNKED, 0);
+        GCancellable *cancel = g_cancellable_new ();
+        GAsyncResult *result = NULL;
+        GError *error = NULL;
+        slow->required_thread = g_thread_self ();
+        slow->fail_writes = mode == 2;
+        g_output_stream_close_async (body, G_PRIORITY_DEFAULT, cancel, close_result, &result);
+        if (mode == 1) g_cancellable_cancel (cancel);
+        while (!result) g_main_context_iteration (NULL, TRUE);
+        gboolean success = g_output_stream_close_finish (body, result, &error);
+        if (mode == 0) {
+                g_assert_true (success);
+                g_assert_no_error (error);
+                g_assert_cmpmem (g_memory_output_stream_get_data (G_MEMORY_OUTPUT_STREAM (memory)),
+                                 g_memory_output_stream_get_data_size (G_MEMORY_OUTPUT_STREAM (memory)), "0\r\n\r\n", 5);
+        } else {
+                g_assert_false (success);
+                int expected = mode == 1 ? G_IO_ERROR_CANCELLED : G_IO_ERROR_BROKEN_PIPE;
+                g_assert_error (error, G_IO_ERROR, expected);
+                g_clear_error (&error);
+        }
+        g_object_unref (result); g_object_unref (cancel);
+        g_object_unref (body); g_object_unref (slow); g_object_unref (memory);
+}
