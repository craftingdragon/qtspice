+/* Complete chunk framing on the owning main context. The default async
+ * close runs close_fn in a worker, which cannot drive main-context-only
+ * pollable streams such as spice-client-glib's in-memory pipe. */
+static void close_async_step (GTask *task);
+
+static gboolean
+close_async_ready (GObject *stream, gpointer data)
+{
+        close_async_step (G_TASK (data));
+        return G_SOURCE_REMOVE;
+}
+
+static void
+close_async_step (GTask *task)
+{
+        SoupBodyOutputStream *stream = g_task_get_source_object (task);
+        SoupBodyOutputStreamPrivate *priv = soup_body_output_stream_get_instance_private (stream);
+        GCancellable *cancellable = g_task_get_cancellable (task);
+        GError *error = NULL;
+
+        if (g_task_return_error_if_cancelled (task))
+                return;
+
+        if (priv->encoding == SOUP_ENCODING_CHUNKED && !priv->eof) {
+                if (soup_body_output_stream_write_chunked (stream, NULL, 0, FALSE,
+                                                          cancellable, &error) == -1) {
+                        if (g_error_matches (error, G_IO_ERROR, G_IO_ERROR_WOULD_BLOCK)) {
+                                GSource *source;
+                                g_clear_error (&error);
+                                source = g_pollable_output_stream_create_source (
+                                        G_POLLABLE_OUTPUT_STREAM (priv->base_stream), cancellable);
+                                g_source_set_priority (source, g_task_get_priority (task));
+                                g_source_set_callback (source, G_SOURCE_FUNC (close_async_ready),
+                                                       g_object_ref (task), g_object_unref);
+                                g_source_attach (source, g_task_get_context (task));
+                                g_source_unref (source);
+                                return;
+                        }
+                        g_task_return_error (task, error);
+                        return;
+                }
+                priv->eof = TRUE;
+        }
+        if (!G_OUTPUT_STREAM_CLASS (soup_body_output_stream_parent_class)->close_fn (
+                    G_OUTPUT_STREAM (stream), cancellable, &error)) {
+                g_task_return_error (task, error);
+                return;
+        }
+        g_task_return_boolean (task, TRUE);
+}
+
+static void
+soup_body_output_stream_close_async (GOutputStream *stream, int priority,
+                                     GCancellable *cancellable,
+                                     GAsyncReadyCallback callback, gpointer data)
+{
+        SoupBodyOutputStreamPrivate *priv = soup_body_output_stream_get_instance_private (SOUP_BODY_OUTPUT_STREAM (stream));
+        if (priv->encoding != SOUP_ENCODING_CHUNKED) {
+                G_OUTPUT_STREAM_CLASS (soup_body_output_stream_parent_class)->close_async (
+                        stream, priority, cancellable, callback, data);
+                return;
+        }
+        GTask *task = g_task_new (stream, cancellable, callback, data);
+        g_task_set_source_tag (task, soup_body_output_stream_close_async);
+        g_task_set_priority (task, priority);
+        /* Do not terminate a body whose preceding chunk failed mid-write. */
+        if (priv->encoding == SOUP_ENCODING_CHUNKED &&
+            priv->chunked_state != SOUP_BODY_OUTPUT_STREAM_STATE_CHUNK_SIZE) {
+                g_task_return_new_error (task, G_IO_ERROR, G_IO_ERROR_PARTIAL_INPUT,
+                                         "Cannot close an incomplete HTTP chunk");
+        } else {
+                close_async_step (task);
+        }
+        g_object_unref (task);
+}
+
+static gboolean
+soup_body_output_stream_close_finish (GOutputStream *stream, GAsyncResult *result,
+                                      GError **error)
+{
+        if (!g_async_result_is_tagged (result, soup_body_output_stream_close_async))
+                return G_OUTPUT_STREAM_CLASS (soup_body_output_stream_parent_class)->close_finish (
+                        stream, result, error);
+        g_return_val_if_fail (g_task_is_valid (result, stream), FALSE);
+        return g_task_propagate_boolean (G_TASK (result), error);
+}
